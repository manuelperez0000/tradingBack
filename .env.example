PORT=3000
# PostgreSQL connection string used by the API and startup migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading
PG_POOL_MAX=10
# Keep a private random secret of at least 32 characters for JWT authentication.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMINS=
PASSWORD_RESET_URL=http://localhost:5173/reset-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Trading App <no-reply@example.com>"
